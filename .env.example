# Copy to .env for local development. Production uses Docker secrets (*_FILE variables).
UPTIVORA_ENV=development
UPTIVORA_EDITION=hosted
UPTIVORA_PUBLIC_URL=http://localhost:3000
UPTIVORA_SECRET_KEY=dev-only-change-me-dev-only-change-me-0000
UPTIVORA_DATABASE_URL=postgresql+asyncpg://uptivora:uptivora@localhost:5433/uptivora

# SMTP (Mailpit in dev: web UI on http://localhost:8025)
UPTIVORA_SMTP_HOST=localhost
UPTIVORA_SMTP_PORT=1025
UPTIVORA_SMTP_SECURITY=none
UPTIVORA_SMTP_FROM=Uptivora <alerts@uptivora.localhost>

# Billing: disabled | test  (stripe is not implemented yet)
UPTIVORA_BILLING_PROVIDER=test
