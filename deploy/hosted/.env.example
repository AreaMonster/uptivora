# Uptivora hosted deployment. Secrets live in ./secrets/, not here.
UPTIVORA_VERSION=0.1.0
UPTIVORA_DOMAIN=app.uptivora.com

UPTIVORA_SMTP_HOST=smtp.example.com
UPTIVORA_SMTP_PORT=587
UPTIVORA_SMTP_SECURITY=starttls
UPTIVORA_SMTP_USERNAME=
UPTIVORA_SMTP_FROM=Uptivora <alerts@uptivora.com>

# disabled | test. "test" simulates payments (TEST MODE) and additionally requires
# UPTIVORA_ALLOW_TEST_BILLING_IN_PRODUCTION=true — only ever on a staging system.
UPTIVORA_BILLING_PROVIDER=disabled

# Capacity
UPTIVORA_WORKERS=2
UPTIVORA_WORKER_CONCURRENCY=100
UPTIVORA_API_PROCESSES=4
UPTIVORA_DB_POOL_SIZE=10
PG_SHARED_BUFFERS=512MB
PG_MAX_CONNECTIONS=200

# Backups (copy BACKUP_DIR off the server, see docs/operations/hosted-deployment.md)
BACKUP_TIME=02:30
BACKUP_KEEP_DAYS=30
BACKUP_DIR=./backups
TZ=Europe/Zurich

# Alert-storm guard: public URLs checked when most monitored sites fail at once. If these
# fail too, the problem is this server's network and alerts are held back. Use 2-3 large,
# independent sites. Leave empty to disable.
UPTIVORA_NETWORK_CANARIES=["https://www.cloudflare.com/", "https://www.wikipedia.org/"]
# Dead man's switch: requested every minute while checks run (e.g. a healthchecks.io URL).
UPTIVORA_HEARTBEAT_URL=

UPTIVORA_TLS=auto
UPTIVORA_SUBNET=10.250.48.0/24
