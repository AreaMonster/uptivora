# Uptivora self-hosted configuration. install.sh copies this file to .env.
# Passwords and keys do NOT go here: they live in ./secrets/ (see docs/selfhosted/install.md).

# ── Required ────────────────────────────────────────────────────────────────
UPTIVORA_VERSION=0.1.0
# Domain name pointing at this server (A/AAAA record). Users open https://<domain>.
UPTIVORA_DOMAIN=monitor.example.com

# Outgoing mail for alerts, invitations and password resets.
UPTIVORA_SMTP_HOST=smtp.example.com
UPTIVORA_SMTP_PORT=587
# starttls (port 587) | tls (port 465) | none (local relay only)
UPTIVORA_SMTP_SECURITY=starttls
UPTIVORA_SMTP_USERNAME=
# The SMTP password goes into secrets/smtp_password.
UPTIVORA_SMTP_FROM=Uptivora <monitoring@example.com>

# ── HTTPS ───────────────────────────────────────────────────────────────────
# auto     = free certificate from Let's Encrypt / ZeroSSL (needs public DNS and ports 80 + 443)
# internal = certificate from Caddy's own CA, for intranet installations without public DNS
UPTIVORA_TLS=auto
UPTIVORA_HTTP_PORT=80
UPTIVORA_HTTPS_PORT=443

# ── Backups ─────────────────────────────────────────────────────────────────
BACKUP_TIME=02:30
BACKUP_KEEP_DAYS=14
TZ=Europe/Zurich

# ── Advanced (leave as is unless you know you need it) ──────────────────────
# Docker network for the web/API/proxy containers. Change it if it collides with your LAN.
UPTIVORA_SUBNET=10.250.47.0/24
# Monitoring engine
UPTIVORA_WORKER_CONCURRENCY=50
# Every check is kept 3 days; failed checks and checks around incidents 30 days;
# hourly summaries (all charts beyond 24 h) 400 days.
UPTIVORA_RAW_RETENTION_DAYS=3
UPTIVORA_FAILED_CHECK_RETENTION_DAYS=30
# Only needed when users reach Uptivora on a non-standard port, e.g. https://monitor.example.com:8443
# UPTIVORA_PUBLIC_URL=
